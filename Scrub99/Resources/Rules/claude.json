{
  "name": "Claude",
  "bundleIdentifier": "com.anthropic.claude",
  "executableName": "Claude",
  "knownPaths": [
    {
      "relativePath": "Library/Application Support/Claude",
      "category": "applicationData",
      "description": "Main app support. Contains databases, models, persistent data."
    },
    {
      "relativePath": "Library/Application Support/Claude-3p",
      "category": "applicationData",
      "description": "Claude Desktop's data folder under the second name it uses on this Mac. It has the shape of a browser profile: its own caches, cookies, local storage, and saved session, plus a folder of Claude Extensions. The caches regenerate on their own; the cookies, local storage, and session do not, so removing the folder as a whole signs the application out and discards local state. The Cache and Code Cache subfolders are the parts worth removing on their own."
    },
    {
      "relativePath": "Library/Caches/com.anthropic.claude",
      "category": "cache",
      "description": "Cache directory. Temporary data that can be safely recreated."
    },
    {
      "relativePath": "Library/Preferences/com.anthropic.claude.plist",
      "category": "preferences",
      "description": "Preferences and settings file."
    },
    {
      "relativePath": "Library/Logs/Claude",
      "category": "logs",
      "description": "Log files."
    },
    {
      "relativePath": "Library/Saved Application State/com.anthropic.claude.savedState",
      "category": "applicationData",
      "description": "Saved app state."
    },
    {
      "relativePath": "Library/Containers/com.anthropic.claude",
      "category": "applicationData",
      "description": "Sandbox container."
    },
    {
      "relativePath": "Library/Group Containers/com.anthropic.claude",
      "category": "applicationData",
      "description": "Shared container."
    },
    {
      "relativePath": "Claude",
      "category": "projectData",
      "description": "User-created Claude projects and workspaces. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": "Documents/Claude",
      "category": "projectData",
      "description": "User-created Claude projects under Documents. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": ".claude",
      "category": "applicationData",
      "description": "Claude Code configuration, sessions, commands, and local state. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": ".claude-vision",
      "category": "applicationData",
      "description": "Claude-related local vision data. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": ".claude.json",
      "category": "credentials",
      "description": "Claude Code's top-level state file. Holds MCP server configuration and per-project pointers. Tiny, but it is configuration rather than cache, and losing it costs more than the space it occupies."
    },
    {
      "relativePath": ".cache/claude",
      "category": "cache",
      "description": "Claude Code cache. Rebuilt on demand."
    }
  ],
  "filePatterns": [
    {
      "pattern": "*.sqlite",
      "directory": "Application Support/Claude",
      "category": "conversationData",
      "description": "Local conversation database"
    },
    {
      "pattern": "*.sqlite-wal",
      "directory": "Application Support/Claude",
      "category": "conversationData",
      "description": "SQLite WAL for conversations"
    },
    {
      "pattern": "*.sqlite-shm",
      "directory": "Application Support/Claude",
      "category": "conversationData",
      "description": "SQLite shared memory"
    }
  ],
  "keywords": [
    "claude",
    "anthropic",
    "com.anthropic"
  ],
  "confidenceBoosters": [
    "bundleIdMatch",
    "appNameMatch",
    "executableMatch",
    "plistFile"
  ],
  "installMethod": "directDownload",
  "documentationURL": "https://docs.anthropic.com/",
  "homepageURL": "https://anthropic.com/",
  "category": "ai",
  "description": "Claude by Anthropic \u2014 an AI assistant application."
}
